# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# LLM API Keys (need at least one)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# LLM fallback order (comma-separated)
LLM_FALLBACK_ORDER=groq,gemini,openrouter,claude

# Browser automation
PLAYWRIGHT_HEADLESS=true

# Agent session budgets
MAX_STEP_BUDGET_DEFAULT=40
MAX_PAGES_DEFAULT=5
SESSION_WALL_CLOCK_TIMEOUT_SECONDS=600

# Worker config
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
WORKER_IDLE_SHUTDOWN_SECONDS=30

# Run mode: "unified" (API + worker in one process for Cloud Run)
#           "webhook" (Supabase webhook triggers jobs, API only)
#           "api_only" (just the API, worker runs separately)
#           "worker_only" (just the worker, for standalone mode)
RUN_MODE=unified

# Webhook secret (required if RUN_MODE=webhook)
WEBHOOK_SECRET=your_secure_random_string_here

# Frontend URL (for CORS — set to your Vercel deployment URL)
FRONTEND_URL=

# Persona limits
MAX_PERSONAS_PER_STUDY=10

# Data retention
SCREENSHOT_RETENTION_DAYS=90

# Environment
ENV=production
